@model List<MyAcademy_PortfolioProject.Entities.SocialMedia>

@{
    ViewData["Title"] = "Sosyal Medya Yönetimi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";

    var totalCount = Model.Count;
    var activeCount = Model.Count(x => x.IsActive);
    var passiveCount = Model.Count(x => !x.IsActive);
}

<style>
    .social-admin {
        --social-primary: #2f5d4e;
        --social-soft: #e7efe9;
        --social-border: #ebe8e1;
    }

        .social-admin .social-card,
        .social-admin .social-stat {
            background: #fff;
            border: 1px solid var(--social-border);
            border-radius: 15px;
            box-shadow: 0 2px 12px rgba(0,0,0,.04);
        }

        .social-admin .social-stat {
            padding: 22px;
            height: 100%;
        }

        .social-admin .stat-label {
            font-size: .87rem;
            color: #888;
        }

        .social-admin .stat-value {
            font-size: 1.9rem;
            font-weight: 700;
            margin-top: 8px;
        }

        .social-admin .stat-icon {
            width: 46px;
            height: 46px;
            display: grid;
            place-items: center;
            border-radius: 12px;
            color: var(--social-primary);
            background: var(--social-soft);
            font-size: 1.3rem;
        }

        .social-admin .social-card {
            padding: 24px;
        }

        .social-admin .add-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 11px 18px;
            border-radius: 10px;
            background: var(--social-primary);
            color: white;
            text-decoration: none;
            font-weight: 600;
        }

            .social-admin .add-btn:hover {
                background: #244a3e;
                color: white;
            }

        .social-admin .social-icon-box {
            width: 44px;
            height: 44px;
            display: grid;
            place-items: center;
            flex-shrink: 0;
            border-radius: 12px;
            background: var(--social-soft);
            color: var(--social-primary);
            font-size: 1.3rem;
        }

        .social-admin .social-order {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 8px;
            background: #f3f2ee;
            font-weight: 600;
        }

        .social-admin .social-status {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: .8rem;
            font-weight: 600;
        }

        .social-admin .status-active {
            background: #e7f2e9;
            color: #287348;
        }

        .social-admin .status-passive {
            background: #f1f1ef;
            color: #777;
        }

        .social-admin .social-search,
        .social-admin .social-filter {
            border: 1px solid var(--social-border);
            background: #fcfbf9;
            border-radius: 10px;
            padding: 10px 13px;
        }

            .social-admin .social-search:focus,
            .social-admin .social-filter:focus {
                outline: none;
                border-color: var(--social-primary);
                box-shadow: 0 0 0 .2rem rgba(47,93,78,.12);
            }

        .social-admin .table thead th {
            background: #faf9f6;
            color: #777;
            font-size: .83rem;
            padding: 15px;
            white-space: nowrap;
        }

        .social-admin .table tbody td {
            padding: 16px 15px;
            border-color: #f1eee8;
        }

        .social-admin .social-link {
            display: inline-block;
            max-width: 280px;
            color: var(--social-primary);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            vertical-align: middle;
            text-decoration: none;
        }

        .social-admin .empty-state {
            text-align: center;
            padding: 50px 20px;
            color: #888;
        }

            .social-admin .empty-state i {
                font-size: 2.5rem;
                color: #a9b9ae;
            }
</style>

<div class="social-admin container-fluid py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h4 class="mb-1">Sosyal Medya Yönetimi</h4>
            <p class="text-muted mb-0">
                Sosyal medya hesaplarınızı ve profil bağlantılarınızı yönetin.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="SocialMedia"
           asp-action="CreateSocialMedia"
           class="add-btn">

            <i class="bi bi-plus-lg"></i>
            Yeni Hesap Ekle
        </a>
    </div>

    <!-- NOTIFICATIONS -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Kapat"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Kapat"></button>
        </div>
    }

    <!-- STATISTICS -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="social-stat">
                <div class="d-flex justify-content-between">
                    <div>
                        <div class="stat-label">Toplam Hesap</div>
                        <div class="stat-value">@totalCount</div>
                    </div>
                    <div class="stat-icon">
                        <i class="bi bi-share"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="social-stat">
                <div class="d-flex justify-content-between">
                    <div>
                        <div class="stat-label">Aktif Hesap</div>
                        <div class="stat-value">@activeCount</div>
                    </div>
                    <div class="stat-icon">
                        <i class="bi bi-check-circle"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="social-stat">
                <div class="d-flex justify-content-between">
                    <div>
                        <div class="stat-label">Pasif Hesap</div>
                        <div class="stat-value">@passiveCount</div>
                    </div>
                    <div class="stat-icon">
                        <i class="bi bi-eye-slash"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- LIST -->
    <div class="social-card">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

            <div>
                <h5 class="mb-1">Sosyal Medya Hesapları</h5>
                <small class="text-muted">
                    Hesaplar gösterim sırasına göre listelenir.
                </small>
            </div>

            <div class="d-flex gap-2 flex-wrap">

                <input type="search"
                       id="socialSearch"
                       class="social-search"
                       aria-label="Sosyal medya hesabı ara"
                       placeholder="Platform ara..." />

                <select id="socialStatusFilter"
                        class="social-filter"
                        aria-label="Hesap durumunu filtrele">

                    <option value="all">Tüm Durumlar</option>
                    <option value="active">Aktif</option>
                    <option value="passive">Pasif</option>
                </select>

            </div>
        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Platform</th>
                        <th>Profil Bağlantısı</th>
                        <th>İkon Sınıfı</th>
                        <th>Sıra</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        var isValidUrl =
                        Uri.TryCreate(
                        item.Url,
                        UriKind.Absolute,
                        out var linkUri) &&
                        (linkUri.Scheme == Uri.UriSchemeHttps ||
                        linkUri.Scheme == Uri.UriSchemeHttp);

                        <tr class="social-row"
                            data-platform="@item.Platform"
                            data-status="@(item.IsActive ? "active" : "passive")">

                            <td>
                                <span class="text-muted">
                                    #@item.SocialMediaId
                                </span>
                            </td>

                            <td>
                                <div class="d-flex align-items-center gap-3">

                                    <div class="social-icon-box">
                                        <i class="@(string.IsNullOrWhiteSpace(item.IconClass) ? "bi bi-link-45deg" : item.IconClass)"></i>
                                    </div>

                                    <div class="fw-semibold">
                                        @item.Platform
                                    </div>

                                </div>
                            </td>

                            <td>
                                @if (isValidUrl)
                                {
                                    <a href="@item.Url"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="social-link"
                                       title="@item.Url">

                                        @item.Url
                                        <i class="bi bi-box-arrow-up-right ms-1"></i>
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">
                                        Geçersiz bağlantı
                                    </span>
                                }
                            </td>

                            <td>
                                <code>@item.IconClass</code>
                            </td>

                            <td>
                                <span class="social-order">
                                    @item.DisplayOrder
                                </span>
                            </td>

                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="social-status status-active">
                                        <i class="bi bi-check-circle me-1"></i>
                                        Aktif
                                    </span>
                                }
                                else
                                {
                                    <span class="social-status status-passive">
                                        <i class="bi bi-eye-slash me-1"></i>
                                        Pasif
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="d-flex justify-content-end gap-2">

                                    <a asp-area="Admin"
                                       asp-controller="SocialMedia"
                                       asp-action="UpdateSocialMedia"
                                       asp-route-id="@item.SocialMediaId"
                                       class="btn btn-warning btn-sm">

                                        <i class="bi bi-pencil-square me-1"></i>
                                        Düzenle
                                    </a>

                                    <form asp-area="Admin"
                                          asp-controller="SocialMedia"
                                          asp-action="DeleteSocialMedia"
                                          asp-route-id="@item.SocialMediaId"
                                          method="post"
                                          onsubmit="return confirm('Bu sosyal medya hesabını silmek istediğinize emin misiniz?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-danger btn-sm">
                                            <i class="bi bi-trash me-1"></i>
                                            Sil
                                        </button>
                                    </form>

                                </div>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>

        </div>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="bi bi-share"></i>
                <h5 class="mt-3">Henüz sosyal medya hesabı yok</h5>
                <p>İlk hesabınızı ekleyerek başlayabilirsiniz.</p>
            </div>
        }
        else
        {
            <div id="socialFilterEmpty"
                 class="empty-state d-none">

                <i class="bi bi-search"></i>
                <h5 class="mt-3">Sonuç bulunamadı</h5>
                <p>Arama veya filtre kriterlerini değiştirin.</p>
            </div>
        }

    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const search = document.getElementById("socialSearch");
        const filter = document.getElementById("socialStatusFilter");

        const rows = Array.from(
            document.querySelectorAll(".social-row")
        );

        const empty = document.getElementById("socialFilterEmpty");

        function normalize(value) {
            return (value || "")
                .toLocaleLowerCase("tr-TR")
                .trim();
        }

        function applyFilter() {

            const keyword = normalize(search.value);
            const status = filter.value;

            let visibleCount = 0;

            rows.forEach(function (row) {

                const platform = normalize(row.dataset.platform);
                const rowStatus = row.dataset.status;

                const matchText = platform.includes(keyword);

                const matchStatus =
                    status === "all" || status === rowStatus;

                const visible = matchText && matchStatus;

                row.classList.toggle("d-none", !visible);

                if (visible) visibleCount++;
            });

            if (empty) {
                empty.classList.toggle(
                    "d-none",
                    visibleCount > 0
                );
            }
        }

        search.addEventListener("input", applyFilter);
        filter.addEventListener("change", applyFilter);

    });
</script>
