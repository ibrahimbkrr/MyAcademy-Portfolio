@model MyAcademy_PortfolioProject.Areas.Admin.Models.SkillFormViewModel

@{
    ViewData["Title"] = "Yeni Yetenek Ekle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<style>
    .skill-form {
        --green: #2f5d4e;
        --soft-green: #e7efe9;
        --line: #ebe8e1;
    }

        .skill-form .form-card {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 16px;
            padding: 1.75rem;
            height: 100%;
            box-shadow: 0 2px 12px rgba(0,0,0,.04);
        }

        .skill-form .form-label {
            font-weight: 600;
            color: #555;
            font-size: .9rem;
        }

        .skill-form .form-control,
        .skill-form .form-select {
            background: #fcfbf9;
            padding: 12px 14px;
            border-radius: 10px;
            border: 1px solid var(--line);
        }

            .skill-form .form-control:focus,
            .skill-form .form-select:focus {
                border-color: var(--green);
                box-shadow: 0 0 0 .2rem rgba(47,93,78,.12);
            }

        .skill-form .level-bar {
            height: 14px;
            border-radius: 20px;
            background: #e9eeeb;
            overflow: hidden;
        }

        .skill-form .level-fill {
            height: 100%;
            background: var(--green);
            transition: width .15s ease;
        }

        .skill-form .form-range {
            accent-color: var(--green);
        }

        .skill-form .primary-btn {
            background: var(--green);
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: 12px 20px;
        }

            .skill-form .primary-btn:hover {
                background: #244a3e;
            }
</style>

<div class="skill-form container-fluid py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h4 class="mb-1">Yeni Yetenek Ekle</h4>
            <p class="text-muted mb-0">
                Portfolyonuza yeni bir teknik yetenek ekleyin.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Skill"
           asp-action="SkillList"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Yetenek Listesine Dön
        </a>
    </div>

    <form asp-area="Admin"
          asp-controller="Skill"
          asp-action="CreateSkill"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="row g-4">

            <!-- LEFT -->
            <div class="col-lg-8">
                <div class="form-card">

                    <h5 class="mb-4">
                        <i class="bi bi-code-slash me-2"></i>
                        Yetenek Bilgileri
                    </h5>

                    <!-- SKILL NAME -->
                    <div class="mb-4">
                        <label asp-for="SkillName" class="form-label">
                            Yetenek Adı *
                        </label>

                        <input asp-for="SkillName"
                               class="form-control"
                               maxlength="100"
                               placeholder="Örn: ASP.NET Core"
                               required />

                        <span asp-validation-for="SkillName"
                              class="text-danger small"></span>
                    </div>

                    <!-- CATEGORY -->
                    <div class="mb-4">
                        <label asp-for="SkillCategoryId" class="form-label">
                            Yetenek Kategorisi *
                        </label>

                        <select asp-for="SkillCategoryId"
                                asp-items="Model.Categories"
                                class="form-select"
                                required>

                            <option value="0">Kategori seçiniz</option>
                        </select>

                        <span asp-validation-for="SkillCategoryId"
                              class="text-danger small"></span>

                        <small class="text-muted d-block mt-2">
                            Kategori bulunmuyorsa önce yetenek kategorisi oluşturun.
                        </small>
                    </div>

                    <!-- ORDER -->
                    <div class="mb-4">
                        <label asp-for="DisplayOrder" class="form-label">
                            Gösterim Sırası
                        </label>

                        <input asp-for="DisplayOrder"
                               type="number"
                               min="0"
                               class="form-control" />

                        <span asp-validation-for="DisplayOrder"
                              class="text-danger small"></span>
                    </div>

                </div>
            </div>

            <!-- RIGHT -->
            <div class="col-lg-4">
                <div class="form-card">

                    <h5 class="mb-4">
                        <i class="bi bi-bar-chart me-2"></i>
                        Yetenek Seviyesi
                    </h5>

                    <div class="mb-3">
                        <label asp-for="Level" class="form-label">
                            Seviye (0-100)
                        </label>

                        <div class="input-group">
                            <input asp-for="Level"
                                   type="number"
                                   min="0"
                                   max="100"
                                   class="form-control" />

                            <span class="input-group-text">%</span>
                        </div>

                        <span asp-validation-for="Level"
                              class="text-danger small"></span>
                    </div>

                    <input type="range"
                           id="levelSlider"
                           class="form-range mb-3"
                           min="0"
                           max="100"
                           value="@Model.Level"
                           aria-label="Yetenek seviyesini ayarla" />

                    <div class="d-flex justify-content-between mb-2">
                        <small class="text-muted">Seviye Önizlemesi</small>

                        <strong id="levelPreviewText">
                            %@Model.Level
                        </strong>
                    </div>

                    <div class="level-bar">
                        <div class="level-fill"
                             id="levelPreviewBar"
                             style="width:@Model.Level%;">
                        </div>
                    </div>

                    <p class="text-muted small mt-3">
                        Belirlediğiniz seviye ana sayfada ilerleme
                        çubuğu olarak gösterilir.
                    </p>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="primary-btn">
                            <i class="bi bi-check-circle me-1"></i>
                            Yeteneği Kaydet
                        </button>

                        <a asp-area="Admin"
                           asp-controller="Skill"
                           asp-action="SkillList"
                           class="btn btn-light">
                            Vazgeç
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </form>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const levelInput = document.getElementById("Level");
        const slider = document.getElementById("levelSlider");
        const previewText = document.getElementById("levelPreviewText");
        const previewBar = document.getElementById("levelPreviewBar");

        function updatePreview(value) {
            const number = Number(value);

            if (!Number.isFinite(number)) return;

            const safeValue = Math.min(100, Math.max(0, number));

            previewText.textContent = "%" + safeValue;
            previewBar.style.width = safeValue + "%";
            slider.value = safeValue;
        }

        slider.addEventListener("input", function () {
            levelInput.value = this.value;
            updatePreview(this.value);
        });

        levelInput.addEventListener("input", function () {
            updatePreview(this.value);
        });

        updatePreview(levelInput.value);
    });
</script>
