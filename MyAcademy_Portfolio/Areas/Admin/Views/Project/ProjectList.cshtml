@model List<MyAcademy_PortfolioProject.Entities.Project>

@{
    ViewData["Title"] = "Proje Yönetimi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<style>
    .project-admin {
        --primary-green: #2f5d4e;
        --soft-green: #e7efe9;
        --border-color: #ebe8e1;
    }

        .project-admin .project-table-card {
            background: #fff;
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 1.5rem;
            box-shadow: 0 2px 12px rgba(0,0,0,.04);
        }

        .project-admin .project-thumbnail {
            width: 90px;
            height: 60px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            background: #f5f5f5;
        }

        .project-admin .project-title {
            font-weight: 600;
            color: #333;
        }

        .project-admin .technology-badge {
            display: inline-block;
            padding: 4px 9px;
            border-radius: 6px;
            background: var(--soft-green);
            color: var(--primary-green);
            font-size: 12px;
            margin: 2px;
        }

        .project-admin .btn-add-project {
            background: var(--primary-green);
            color: #fff;
            border: none;
            border-radius: 9px;
            padding: 10px 18px;
            text-decoration: none;
        }

            .project-admin .btn-add-project:hover {
                background: #244a3e;
                color: #fff;
            }

        .project-admin .status-active {
            background: #e7efe9;
            color: #2f5d4e;
        }

        .project-admin .status-passive {
            background: #f1f1f1;
            color: #777;
        }
</style>

<div class="project-admin container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h4 class="mb-1">Proje Yönetimi</h4>
            <p class="text-muted mb-0">
                Portfolyonuzdaki projeleri buradan yönetebilirsiniz.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Project"
           asp-action="CreateProject"
           class="btn-add-project">

            <i class="bi bi-plus-lg me-1"></i>
            Yeni Proje Ekle
        </a>

    </div>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Kapat">
            </button>
        </div>
    }

    <!-- Error Message -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Kapat">
            </button>
        </div>
    }

    <!-- Project Table -->
    <div class="project-table-card">

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Görsel</th>
                        <th>Proje</th>
                        <th>Kategori</th>
                        <th>Teknolojiler</th>
                        <th>Eklenme Tarihi</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>@item.ProjectId</td>

                            <!-- Project Image -->
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl"
                                         alt="@item.ProjectTitle"
                                         class="project-thumbnail" />
                                }
                                else
                                {
                                    <div class="project-thumbnail d-flex align-items-center justify-content-center">
                                        <i class="bi bi-image text-muted fs-4"></i>
                                    </div>
                                }
                        </td>

                        <!-- Project Name -->
                        <td>
                            <div class="project-title">
                                @item.ProjectTitle
                            </div>

                            <small class="text-muted">
                                @(string.IsNullOrWhiteSpace(item.Description)
                                                                ? "Açıklama bulunmuyor."
                                                                : item.Description.Length > 70
                                                                ? item.Description.Substring(0, 70) + "..."
                                                                : item.Description)
                            </small>
                        </td>

                            <!-- Category -->
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @(item.Category?.CategoryName ?? "Kategori Yok")
                                </span>
                            </td>

                            <!-- Technologies -->
                            <td>
                            @if (!string.IsNullOrWhiteSpace(item.Technologies))
                                {
                                    var technologies = item.Technologies
                                    .Split('|', StringSplitOptions.RemoveEmptyEntries);

                                    foreach (var technology in technologies)
                                    {
                                        <span class="technology-badge">
                                            @technology.Trim()
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">
                                        Belirtilmemiş
                                    </span>
                                }
                            </td>

                            <!-- Created Date -->
                            <td>
                                @item.CreatedDate.ToString("dd.MM.yyyy")
                            </td>

                            <!-- Status -->
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge status-active">
                                        <i class="bi bi-check-circle me-1"></i>
                                        Aktif
                                    </span>
                                }
                                else
                                {
                                    <span class="badge status-passive">
                                        <i class="bi bi-dash-circle me-1"></i>
                                        Pasif
                                    </span>
                                }
                            </td>

                            <!-- Actions -->
                            <td>
                                <div class="d-flex flex-wrap gap-2">

                                    <a asp-area="Admin"
                                       asp-controller="Project"
                                       asp-action="UpdateProject"
                                       asp-route-id="@item.ProjectId"
                                       class="btn btn-warning btn-sm">
                                        <i class="bi bi-pencil-square"></i>
                                        Düzenle
                                    </a>

                                    <form asp-area="Admin"
                                          asp-controller="Project"
                                          asp-action="DeleteProject"
                                          asp-route-id="@item.ProjectId"
                                          method="post"
                                          onsubmit="return confirm('Bu projeyi silmek istediğinize emin misiniz?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-danger btn-sm">
                                            <i class="bi bi-trash"></i>
                                            Sil
                                        </button>
                                    </form>

                                </div>
                            </td>

                        </tr>
                    }

                </tbody>
            </table>

        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5">

                <i class="bi bi-folder-x fs-1 text-muted"></i>

                <h5 class="mt-3">
                    Henüz proje bulunmuyor
                </h5>

                <p class="text-muted">
                    İlk projenizi ekleyerek başlayabilirsiniz.
                </p>

            </div>
        }

    </div>

</div>
