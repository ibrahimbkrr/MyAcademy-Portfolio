@model MyAcademy_PortfolioProject.Areas.Admin.Models.LoginViewModel

@{
    ViewData["Title"] = "Admin Giriş";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Admin Giriş | MyAcademy Portfolio</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <style>
        :root {
            --primary: #2f5d4e;
            --primary-dark: #244a3e;
            --soft: #e7efe9;
            --cream: #f8f7f3;
            --border: #e5e9e3;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: var(--cream);
            font-family: "Segoe UI", Arial, sans-serif;
            color: #29372f;
        }

        .login-wrapper {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1fr 1fr;
        }

        .login-brand {
            background: linear-gradient(145deg, #2f5d4e, #172e27);
            color: #fff;
            padding: 70px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
        }

            .login-brand::after {
                content: "";
                position: absolute;
                width: 420px;
                height: 420px;
                border-radius: 50%;
                border: 1px solid rgba(255,255,255,.12);
                right: -140px;
                bottom: -120px;
                box-shadow: 0 0 0 65px rgba(255,255,255,.025), 0 0 0 130px rgba(255,255,255,.025);
                pointer-events: none;
            }

        .brand-header {
            display: flex;
            align-items: center;
            gap: 14px;
            position: relative;
            z-index: 1;
        }

        .brand-icon {
            display: grid;
            place-items: center;
            width: 52px;
            height: 52px;
            background: rgba(255,255,255,.14);
            border-radius: 14px;
            font-size: 25px;
        }

        .brand-header h5 {
            margin: 0;
            font-weight: 700;
        }

        .brand-header small {
            color: #c3d5ca;
        }

        .brand-content {
            position: relative;
            z-index: 1;
            max-width: 480px;
        }

            .brand-content .eyebrow {
                color: #b4d6c2;
                font-size: .82rem;
                letter-spacing: 2px;
                font-weight: 700;
                margin-bottom: 20px;
            }

            .brand-content h1 {
                font-size: clamp(2.5rem, 4vw, 4rem);
                font-weight: 750;
                line-height: 1.15;
                margin-bottom: 25px;
            }

            .brand-content p {
                font-size: 1rem;
                line-height: 1.9;
                color: #c5d5cb;
            }

        .brand-footer {
            position: relative;
            z-index: 1;
            color: #bdcec2;
            font-size: .85rem;
        }

        .login-form-side {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 45px 24px;
        }

        .login-card {
            width: 100%;
            max-width: 440px;
        }

        .welcome-icon {
            width: 62px;
            height: 62px;
            border-radius: 17px;
            background: var(--soft);
            color: var(--primary);
            display: grid;
            place-items: center;
            font-size: 28px;
            margin-bottom: 28px;
        }

        .login-card h2 {
            font-size: 2rem;
            font-weight: 750;
            margin-bottom: 10px;
        }

        .login-subtitle {
            color: #828880;
            line-height: 1.7;
            margin-bottom: 35px;
        }

        .form-label {
            font-weight: 600;
            color: #3e4d43;
            margin-bottom: 9px;
            font-size: .9rem;
        }

        .input-wrapper {
            position: relative;
        }

            .input-wrapper .field-icon {
                position: absolute;
                top: 50%;
                left: 16px;
                transform: translateY(-50%);
                color: #89958c;
                pointer-events: none;
            }

        .form-control {
            height: 54px;
            border: 1px solid var(--border);
            background: #fff;
            border-radius: 12px;
            padding: 12px 47px;
        }

            .form-control:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 .2rem rgba(47,93,78,.12);
            }

        .password-toggle {
            position: absolute;
            top: 50%;
            right: 10px;
            transform: translateY(-50%);
            border: none;
            background: none;
            color: #77877d;
            padding: 8px;
            cursor: pointer;
        }

        .form-check-input:checked {
            background-color: var(--primary);
            border-color: var(--primary);
        }

        .login-submit {
            width: 100%;
            min-height: 54px;
            border: none;
            background: var(--primary);
            color: #fff;
            border-radius: 12px;
            font-weight: 700;
            transition: background .2s;
        }

            .login-submit:hover {
                background: var(--primary-dark);
            }

            .login-submit:disabled {
                opacity: .7;
                cursor: not-allowed;
            }

        .back-link {
            color: var(--primary);
            text-decoration: none;
            font-size: .9rem;
            font-weight: 600;
        }

            .back-link:hover {
                text-decoration: underline;
            }

        .security-note {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            color: #939a94;
            font-size: .82rem;
            margin-top: 30px;
        }

        @@media (max-width: 991px) {
            .login-wrapper {
                grid-template-columns: 1fr;
            }

            .login-brand {
                display: none;
            }

            .login-form-side {
                min-height: 100vh;
            }
        }

        @@media (max-width: 575px) {
            .login-card h2 {
                font-size: 1.7rem;
            }
        }
    </style>
</head>

<body>

    <div class="login-wrapper">

        <!-- LEFT BRAND AREA -->
        <section class="login-brand">

            <div class="brand-header">

                <div class="brand-icon">
                    <i class="bi bi-code-slash"></i>
                </div>

                <div>
                    <h5>MyAcademy Portfolio</h5>
                    <small>Yönetim Sistemi</small>
                </div>

            </div>

            <div class="brand-content">

                <div class="eyebrow">
                    YÖNETİM PANELİ
                </div>

                <h1>
                    Portfolyonuzu
                    tek bir yerden
                    yönetin.
                </h1>

                <p>
                    Projelerinizi, deneyimlerinizi, yeteneklerinizi
                    ve tüm portfolyo içeriklerinizi güvenli
                    yönetim paneliniz üzerinden güncelleyin.
                </p>

            </div>

            <div class="brand-footer">
                © @DateTime.Now.Year MyAcademy Portfolio
            </div>

        </section>

        <!-- RIGHT LOGIN AREA -->
        <main class="login-form-side">

            <div class="login-card">

                <div class="welcome-icon">
                    <i class="bi bi-shield-lock"></i>
                </div>

                <h2>Tekrar Hoş Geldiniz</h2>

                <p class="login-subtitle">
                    Yönetim paneline erişmek için
                    hesabınızla giriş yapın.
                </p>

                <form asp-area="Admin"
                      asp-controller="Account"
                      asp-action="Login"
                      method="post"
                      id="loginForm">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <!-- EMAIL -->
                    <div class="mb-4">

                        <label asp-for="Email" class="form-label">
                            E-posta Adresi
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-envelope field-icon"></i>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   autocomplete="username"
                                   maxlength="254"
                                   placeholder="E-posta adresiniz" />

                        </div>

                        <span asp-validation-for="Email"
                              class="text-danger small"></span>

                    </div>

                    <!-- PASSWORD -->
                    <div class="mb-3">

                        <label asp-for="Password" class="form-label">
                            Parola
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-lock field-icon"></i>

                            <input asp-for="Password"
                                   type="password"
                                   class="form-control"
                                   autocomplete="current-password"
                                   placeholder="Parolanız" />

                            <button type="button"
                                    class="password-toggle"
                                    id="togglePassword"
                                    aria-label="Parolayı göster"
                                    aria-pressed="false">

                                <i class="bi bi-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="Password"
                              class="text-danger small"></span>

                    </div>

                    <!-- REMEMBER ME -->
                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <div class="form-check">

                            <input asp-for="RememberMe"
                                   class="form-check-input" />

                            <label asp-for="RememberMe"
                                   class="form-check-label small">
                                Beni Hatırla
                            </label>

                        </div>

                    </div>

                    <!-- SUBMIT -->
                    <button type="submit"
                            class="login-submit"
                            id="loginButton">

                        <i class="bi bi-box-arrow-in-right me-2"></i>
                        Giriş Yap
                    </button>

                </form>

                <div class="text-center mt-4">

                    <a asp-area=""
                       asp-controller="Default"
                       asp-action="Index"
                       class="back-link">

                        <i class="bi bi-arrow-left me-1"></i>
                        Portfolyoya Geri Dön
                    </a>

                </div>

                <div class="security-note">
                    <i class="bi bi-shield-check"></i>
                    Güvenli yönetim paneli
                </div>

            </div>

        </main>

    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const password =
                document.getElementById("Password");

            const toggle =
                document.getElementById("togglePassword");

            const toggleIcon = toggle.querySelector("i");

            toggle.addEventListener("click", function () {

                const isPassword = password.type === "password";

                password.type = isPassword ? "text" : "password";

                toggleIcon.className = isPassword
                    ? "bi bi-eye-slash"
                    : "bi bi-eye";

                toggle.setAttribute(
                    "aria-pressed",
                    isPassword ? "true" : "false"
                );

                toggle.setAttribute(
                    "aria-label",
                    isPassword ? "Parolayı gizle" : "Parolayı göster"
                );
            });

            const form = document.getElementById("loginForm");
            const button = document.getElementById("loginButton");

            form.addEventListener("submit", function () {

                if (!form.checkValidity()) {
                    return;
                }

                button.disabled = true;
                button.innerHTML =
                    '<span class="spinner-border spinner-border-sm me-2"></span>' +
                    'Giriş Yapılıyor...';
            });

        });
    </script>

</body>
</html>
