@model List<MyAcademy_PortfolioProject.Entities.Category>

@{
    ViewData["Title"] = "Kategori Yönetimi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";

    var totalCategories = Model.Count;
    var totalProjects = Model.Sum(x => x.Projects.Count);
    var usedCategories = Model.Count(x => x.Projects.Any());
}

<style>
    .cat-admin {
        --g: #2f5d4e;
        --g-soft: #e7efe9;
        --line: #ebe8e1;
        --muted: #8a8a85;
    }

    .cat-card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 1.5rem;
        box-shadow: 0 2px 12px rgba(0,0,0,.04);
    }

    .cat-stat {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 1.3rem;
        height: 100%;
    }

    .cat-stat-value {
        font-size: 1.8rem;
        font-weight: 700;
        color: #333;
    }

    .cat-stat-label {
        color: var(--muted);
        font-size: .85rem;
    }

    .cat-btn {
        background: var(--g);
        color: #fff;
        border-radius: 9px;
        padding: .65rem 1rem;
        text-decoration: none;
        border: none;
    }

        .cat-btn:hover {
            background: #244a3e;
            color: #fff;
        }

    .cat-filter {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 7px;
        background: var(--g-soft);
        color: var(--g);
        font-size: .8rem;
        font-weight: 500;
    }

    .cat-count {
        background: #edf1f5;
        color: #526575;
        border-radius: 8px;
        padding: 5px 10px;
        font-size: .8rem;
    }
</style>

<div class="cat-admin container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h4 class="mb-1">Kategori Yönetimi</h4>
            <p class="text-muted mb-0">
                Projelerinizin kategorilerini buradan yönetebilirsiniz.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Category"
           asp-action="CreateCategory"
           class="cat-btn">

            <i class="bi bi-plus-lg me-1"></i>
            Yeni Kategori Ekle
        </a>

    </div>

    <!-- Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Kapat">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Kapat">
            </button>
        </div>
    }

    <!-- Statistics -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="cat-stat">
                <div class="cat-stat-label">Toplam Kategori</div>
                <div class="cat-stat-value">@totalCategories</div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="cat-stat">
                <div class="cat-stat-label">Kategoriye Bağlı Projeler</div>
                <div class="cat-stat-value">@totalProjects</div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="cat-stat">
                <div class="cat-stat-label">Kullanılan Kategoriler</div>
                <div class="cat-stat-value">@usedCategories</div>
            </div>
        </div>

    </div>

    <!-- Category Table -->
    <div class="cat-card">

        <div class="table-responsive">

            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Kategori Adı</th>
                        <th>Filtre Anahtarı</th>
                        <th>Proje Sayısı</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.CategoryId</td>

                            <td class="fw-semibold">
                                @item.CategoryName
                            </td>

                            <td>
                                <span class="cat-filter">
                                    @(string.IsNullOrWhiteSpace(item.FilterKey)
                                                                    ? "Tanımlanmamış"
                                                                    : item.FilterKey)
                            </span>
                        </td>

                            <td>
                                <span class="cat-count">
                                    @item.Projects.Count proje
                                </span>
                            </td>

                            <td>
                            @if (item.Projects.Any())
                                {
                                    <span class="badge bg-success">
                                        Kullanılıyor
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Boş
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="d-flex flex-wrap gap-2">

                                    <a asp-area="Admin"
                                       asp-controller="Category"
                                       asp-action="UpdateCategory"
                                       asp-route-id="@item.CategoryId"
                                       class="btn btn-warning btn-sm">

                                        <i class="bi bi-pencil-square me-1"></i>
                                        Düzenle
                                    </a>

                                    @if (!item.Projects.Any())
                                    {
                                        <form asp-area="Admin"
                                              asp-controller="Category"
                                              asp-action="DeleteCategory"
                                              asp-route-id="@item.CategoryId"
                                              method="post"
                                              onsubmit="return confirm('Bu kategoriyi silmek istediğinize emin misiniz?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-danger btn-sm">
                                                <i class="bi bi-trash me-1"></i>
                                                Sil
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn btn-outline-secondary btn-sm"
                                                disabled
                                                title="Bu kategoriye bağlı projeler var.">
                                            <i class="bi bi-lock me-1"></i>
                                            Silinemez
                                        </button>
                                    }

                                </div>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>

        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-tags fs-1 text-muted"></i>
                <h5 class="mt-3">Henüz kategori bulunmuyor</h5>
                <p class="text-muted">
                    İlk kategorinizi ekleyerek başlayabilirsiniz.
                </p>
            </div>
        }

    </div>

</div>
