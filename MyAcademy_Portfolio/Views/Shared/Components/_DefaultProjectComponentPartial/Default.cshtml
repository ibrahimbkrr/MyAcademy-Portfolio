@using MyAcademy_PortfolioProject.Infrastructure
@model MyAcademy_PortfolioProject.Models.ProjectViewModel

<section id="projects">
    <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 gap-3 reveal-on-scroll">
            <div>
                <div class="eyebrow-badge">
                    <i class="bi bi-folder-check"></i> SEÇİLMİŞ ÇALIŞMALAR
                </div>
                <h2 class="section-title mb-1">
                    Fikirden Ürüne Dönüşen Projeler
                </h2>
                <p class="section-description mb-0">
                    Öğrenme, üretme ve problem çözme süreçlerimin birer yansıması olan projelerimden bazıları.
                </p>
            </div>

            <!-- Filter Buttons -->
            <div class="d-flex flex-wrap gap-2" id="projectFilters">
                <button type="button" class="filter-btn active" data-filter="all">Tümü</button>

                @foreach (var category in Model.Categories)
                {
                    <button type="button" class="filter-btn" data-filter="@category.FilterKey">
                        @category.CategoryName
                    </button>
                }
            </div>
        </div>

        <!-- Project Grid -->
        <div class="row g-4" id="projectGrid">

            @foreach (var item in Model.Projects)
            {
                <div class="col-lg-6 project-item reveal-on-scroll" data-category="@item.Category.FilterKey">
                    <div class="project-card">

                        <div class="project-thumb-wrap">
                            @if (PublicLinks.IsAsset(item.ImageUrl)) { <img src="@item.ImageUrl"
                                 alt="@item.ProjectTitle"
                                 class="project-thumb-img"> }

                            <span class="project-category-tag">
                                @item.Category.CategoryName
                            </span>
                        </div>

                        <div class="project-body">
                            <h3 class="h4 fw-bold mb-2">
                                @item.ProjectTitle
                            </h3>

                            <p class="text-muted small mb-4 flex-grow-1">
                                @item.Description
                            </p>

                            <div class="mb-4">
                                @foreach (var technology in (item.Technologies ?? "")
                                                            .Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                {
                                    <span class="tech-badge">@technology</span>
                                }
                            </div>

                            <div class="d-flex align-items-center justify-content-between pt-3 border-top">

                                @if (PublicLinks.IsWeb(item.LiveUrl))
                                {
                                    <a href="@item.LiveUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="btn-sage btn-sm">
                                        <span>Projeyi İncele</span>
                                        <i class="bi bi-arrow-up-right"></i>
                                    </a>
                                }
                                else if (PublicLinks.IsWeb(item.GithubUrl))
                                {
                                    <a href="@item.GithubUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="btn-sage btn-sm">
                                        <span>Projeyi İncele</span>
                                        <i class="bi bi-arrow-up-right"></i>
                                    </a>
                                }

                                @if (PublicLinks.IsWeb(item.GithubUrl))
                                {
                                    <a href="@item.GithubUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="text-muted small text-decoration-none">
                                        <i class="bi bi-github me-1"></i> GitHub
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>

        @if (!Model.Projects.Any())
        {
            <div class="text-center py-5">
                <p class="text-muted">
                    Henüz görüntülenecek proje bulunmuyor.
                </p>
            </div>
        }

        @if (PublicLinks.IsWeb(Model.AllProjectsUrl))
        {
        <div class="text-center mt-5">
            <a href="@Model.AllProjectsUrl"
               target="_blank"
               rel="noopener noreferrer"
               class="btn-secondary-custom px-4 py-3">
                <span>Tüm Projelerimi Gör</span>
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        }
    </div>
</section>
