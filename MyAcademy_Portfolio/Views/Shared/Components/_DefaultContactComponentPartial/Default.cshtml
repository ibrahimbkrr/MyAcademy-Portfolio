@using MyAcademy_PortfolioProject.Infrastructure
@model MyAcademy_PortfolioProject.Models.ContactViewModel

<section id="contact">
    <div class="container">
        <div class="row gy-5">

            <!-- Left Column: Contact Info -->
            <div class="col-lg-5 reveal-on-scroll">

                <div class="eyebrow-badge">
                    <i class="bi bi-envelope-paper-fill"></i>
                    @Model.Contact.SectionLabel
                </div>

                <h2 class="section-title">
                    @Model.Contact.Title
                </h2>

                <p class="text-muted mb-4 fs-6">
                    @Model.Contact.Description
                </p>

                <div class="d-flex flex-column gap-3 mb-4">

                    <!-- Email -->
                    @if (!string.IsNullOrWhiteSpace(Model.Contact.Email)) {
                    <div class="d-flex align-items-center gap-3 p-3 bg-white border rounded-3 shadow-sm">

                        <div class="skill-icon-box mb-0"
                             style="width: 44px; height: 44px; background: var(--bg-secondary);">
                            <i class="bi bi-envelope"></i>
                        </div>

                        <div>
                            <div class="text-muted small">E-posta</div>

                            <a href="mailto:@Model.Contact.Email"
                               class="fw-semibold text-decoration-none text-dark">
                                @Model.Contact.Email
                            </a>
                        </div>
                    </div>

                    }
                    <!-- Location -->
                    <div class="d-flex align-items-center gap-3 p-3 bg-white border rounded-3 shadow-sm">

                        <div class="skill-icon-box mb-0"
                             style="width: 44px; height: 44px; background: var(--bg-secondary);">
                            <i class="bi bi-geo-alt"></i>
                        </div>

                        <div>
                            <div class="text-muted small">Konum</div>
                            <div class="fw-semibold">
                                @Model.Contact.Location
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Social Links -->
                <div class="pt-2">
                    <div class="text-muted small font-heading fw-semibold mb-2">
                        Sosyal Ağlar:
                    </div>

                    <div class="d-flex gap-2">

                        @foreach (var item in Model.SocialMedias.Where(x => PublicLinks.IsWeb(x.Url)))
                        {
                            <a href="@item.Url"
                               target="@(item.Url.StartsWith("mailto:", StringComparison.OrdinalIgnoreCase) ? "_self" : "_blank")"
                               rel="noopener noreferrer"
                               class="social-pill"
                               title="@item.Platform">

                                <i class="@item.IconClass"></i>

                            </a>
                        }

                    </div>
                </div>
            </div>

            <!-- Right Column: Form -->
            <div class="col-lg-7 ps-lg-5 reveal-on-scroll">

                <div class="bg-white p-4 p-md-5 rounded-4 border shadow-sm">

                    <form id="contactForm"
                          action="@Url.Action("Send", "Contact")"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="row g-3">

                            <!-- Full Name -->
                            <div class="col-md-6">

                                <label for="fullName"
                                       class="form-label small fw-semibold">
                                    Adınız Soyadınız *
                                </label>

                                <input type="text"
                                       class="form-control form-control-custom"
                                       id="fullName"
                                       name="FullName"
                                       maxlength="100"
                                       placeholder="Örn: Ahmet Yılmaz"
                                       required>

                            </div>

                            <!-- Email -->

                            <div class="col-md-6">

                                <label for="emailAddr"
                                       class="form-label small fw-semibold">
                                    E-posta Adresiniz *
                                </label>

                                <input type="email"
                                       class="form-control form-control-custom"
                                       id="emailAddr"
                                       name="Email"
                                       maxlength="200"
                                       placeholder="ad@ornek.com"
                                       required>

                            </div>

                            <!-- Subject -->
                            <div class="col-12">

                                <label for="subject"
                                       class="form-label small fw-semibold">
                                    Konu
                                </label>

                                <input type="text"
                                       class="form-control form-control-custom"
                                       id="subject"
                                       name="Subject"
                                       maxlength="200"
                                       placeholder="Örn: İş Birliği veya Yazılım Projesi">

                            </div>

                            <!-- Message -->
                            <div class="col-12">

                                <label for="message"
                                       class="form-label small fw-semibold">
                                    Mesajınız *
                                </label>

                                <textarea class="form-control form-control-custom"
                                          id="message"
                                          name="Content"
                                          rows="5"
                                          maxlength="5000"
                                          placeholder="Projeniz veya sorunuz hakkında detayları paylaşın..."
                                          required></textarea>

                            </div>

                            <!-- Submit -->
                            <div class="col-12 pt-2">

                                <button type="submit"
                                        class="btn-sage w-100 justify-content-center py-3 fs-6">

                                    <i class="bi bi-send-fill"></i>
                                    <span>Mesajımı Gönder</span>

                                </button>

                                <!-- Feedback -->
                                <div id="formFeedback"
                                     class="mt-2 text-center small"
                                     role="status"
                                     aria-live="polite">

                                    @if (TempData["ContactSuccess"] != null)
                                    {
                                        <div class="alert alert-success mt-3">
                                            <i class="bi bi-check-circle-fill me-1"></i>
                                            @TempData["ContactSuccess"]
                                        </div>
                                    }

                                    @if (TempData["ContactError"] != null)
                                    {
                                        <div class="alert alert-danger mt-3">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                            @TempData["ContactError"]
                                        </div>
                                    }

                                </div>

                                <div class="text-muted text-center small mt-3"
                                     style="font-size: 0.78rem;">

                                    <i class="bi bi-shield-check me-1"></i>
                                    İletişim bilgileriniz yalnızca talebinize yanıt vermek amacıyla işlenir.

                                </div>

                            </div>
                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</section>
