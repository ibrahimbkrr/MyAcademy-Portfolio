@model MyAcademy_PortfolioProject.Models.EducationViewModel

<section id="education" class="bg-white border-top border-bottom">
    <div class="container">
        <div class="row gy-5">

            <!-- Left: Timeline -->
            <div class="col-lg-7 reveal-on-scroll">

                <div class="eyebrow-badge">
                    <i class="bi bi-mortarboard-fill"></i>
                    @Model.EducationContent.SectionLabel
                </div>

                <h2 class="section-title mb-4">
                    @Model.EducationContent.SectionTitle
                </h2>

                <div class="d-flex flex-column gap-4">

                    @foreach (var item in Model.Educations)
                    {
                        <div class="p-4 rounded-4 border bg-light">

                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">

                                <h3 class="h5 fw-bold mb-0">
                                    @item.Title
                                </h3>

                                <span class="badge bg-secondary-subtle text-dark">
                                    @item.EducationType
                                </span>
                            </div>

                            <div class="text-muted fw-semibold small mb-2 font-heading">
                                @item.Institution
                            </div>

                            @if (item.StartDate.HasValue || item.EndDate.HasValue || item.IsCurrent)
                            {
                                <div class="text-muted small mb-2">
                                    <i class="bi bi-calendar3 me-1"></i>

                                    @if (item.StartDate.HasValue)
                                    {
                                        @item.StartDate.Value.ToString("MM.yyyy")

                                        if (item.IsCurrent || item.EndDate.HasValue)
                                        {
                                            <span> - </span>
                                        }
                                    }

                                    @if (item.IsCurrent)
                                    {
                                        <span>Devam Ediyor</span>
                                    }
                                    else if (item.EndDate.HasValue)
                                    {
                                        @item.EndDate.Value.ToString("MM.yyyy")
                                    }
                                </div>
                            }
                            <p class="text-muted small mb-0">
                                @item.Description
                            </p>

                        </div>
                    }

                </div>
            </div>

            <!-- Right: Learning Philosophy Quote -->
            <div class="col-lg-5 ps-lg-4 d-flex align-items-center reveal-on-scroll">

                <div class="p-4 p-md-5 rounded-4 border w-100"
                     style="background-color: var(--bg-primary);">

                    <i class="bi bi-quote fs-1 text-muted opacity-50"></i>

                    <blockquote class="fs-4 fw-bold font-heading my-3 text-dark">
                        @Model.EducationContent.Quote
                    </blockquote>

                    <p class="text-muted small mb-0 lh-lg">
                        @Model.EducationContent.Description
                    </p>

                </div>
            </div>

        </div>
    </div>
</section>