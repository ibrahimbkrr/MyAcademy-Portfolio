@using MyAcademy_PortfolioProject.Infrastructure
@model MyAcademy_PortfolioProject.Entities.About

<section id="about" class="bg-white border-top border-bottom">
    <div class="container">
        <div class="row align-items-center gy-5">
            <!-- Left Column: Portrait and visual composition -->
            <div class="col-lg-5 reveal-on-scroll">
                <div class="about-img-wrap">
                    @if (PublicLinks.IsAsset(Model.ImageUrl)) { <img src="@Model.ImageUrl" alt="@Model.Name portre" class="w-100" style="height: 540px; object-fit: cover; object-position: center top;"> }
                    <div class="p-3 bg-light border-top d-flex align-items-center justify-content-between">
                        <span class="small text-muted font-heading">@Model.Name, @Model.Location</span>
                        <span class="badge bg-secondary-subtle text-dark fw-medium">@Model.JobTitle</span>
                    </div>
                </div>
            </div>

            <!-- Right Column: Story & Stats -->
            <div class="col-lg-7 ps-lg-5 reveal-on-scroll">
                <div class="eyebrow-badge">
                    <i class="bi bi-person-lines-fill"></i> @Model.SectionLabel
                </div>
                <h2 class="section-title">
                    @Model.Title
                </h2>
                <div class="text-muted fs-5 mb-4 lh-base">
                    <p class="mb-3">
                        @Model.Description1
                    </p>
                    <p class="mb-4">
                        @Model.Description2
                    </p>
                </div>

                <!-- Statistics -->
                <!-- Statistics -->
                <div class="row g-4 pt-2 pb-4 border-top border-bottom mb-4">
                    <div class="col-4 text-center">
                        <div class="stat-number about-tech-value">@Model.Stat1Value</div>
                        <div class="stat-label">@Model.Stat1Label</div>
                    </div>
                    <div class="col-4 text-center">
                        <div class="stat-number about-tech-value">@Model.Stat2Value</div>
                        <div class="stat-label">@Model.Stat2Label</div>
                    </div>
                    <div class="col-4 text-center">
                        <div class="stat-number about-tech-value">@Model.Stat3Value</div>
                        <div class="stat-label">@Model.Stat3Label</div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    @if (PublicLinks.IsAsset(Model.CvUrl))
                    {
                        <a href="@Model.CvUrl" target="_blank" rel="noopener noreferrer" class="btn-sage">
                            <i class="bi bi-file-earmark-pdf"></i>
                            <span>Özgeçmişimi İncele</span>
                        </a>
                    }
                    <a href="#contact" class="btn-secondary-custom">
                        <span>Bana Ulaşın</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>